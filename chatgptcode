```

</LinearLayout>

## MainActivity.java

package com.example.app;

import android.database.*;
import android.database.sqlite.*;
import android.os.Bundle;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;
import java.util.*;

public class MainActivity extends AppCompatActivity {

```
SQLiteDatabase db;
ListView list;

protected void onCreate(Bundle b){
    super.onCreate(b);
    setContentView(R.layout.activity_main);

    list=findViewById(R.id.list);

    db=openOrCreateDatabase("lib",MODE_PRIVATE,null);
    db.execSQL("CREATE TABLE IF NOT EXISTS books(id INTEGER,name TEXT,status TEXT)");
    db.execSQL("INSERT INTO books VALUES(1,'Java','Available')");

    findViewById(R.id.load).setOnClickListener(v->load());
    findViewById(R.id.lend).setOnClickListener(v->update("Lent"));
    findViewById(R.id.reserve).setOnClickListener(v->update("Reserved"));
}

void load(){
    ArrayList<String> arr=new ArrayList<>();
    Cursor c=db.rawQuery("SELECT * FROM books",null);
    while(c.moveToNext()){
        arr.add(c.getString(1)+"-"+c.getString(2));
    }
    list.setAdapter(new ArrayAdapter<>(this,android.R.layout.simple_list_item_single_choice,arr));
    list.setChoiceMode(ListView.CHOICE_MODE_SINGLE);
}

void update(String s){
    int p=list.getCheckedItemPosition();
    if(p==-1)return;
    db.execSQL("UPDATE books SET status='"+s+"' WHERE id="+(p+1));
    load();
}
```

}

