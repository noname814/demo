var entries = JSON.parse(localStorage.getItem('entries') || '[]');

document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('entryDate').valueAsDate = new Date();
    renderEntries();
    renderWeekly();
});

function showTab(name) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    event.target.classList.add('active');
    if (name === 'weekly') renderWeekly();
}

function addEntry() {
    var date = document.getElementById('entryDate').value;
    var type = document.getElementById('entryType').value;
    var category = document.getElementById('entryCategory').value;
    var amount = parseFloat(document.getElementById('entryAmount').value);
    var note = document.getElementById('entryNote').value.trim();

    if (!date || !amount || amount <= 0) { alert('Please enter a valid date and amount.'); return; }

    entries.unshift({ date, type, category, amount, note });
    localStorage.setItem('entries', JSON.stringify(entries));
    document.getElementById('entryAmount').value = '';
    document.getElementById('entryNote').value = '';
    renderEntries();
    alert('Entry added!');
}

function renderEntries() {
    var html = '';
    var recent = entries.slice(0, 10);
    if (recent.length === 0) { html = '<p style="text-align:center;color:#888;padding:20px;">No entries yet.</p>'; }
    recent.forEach(function(e) {
        var cls = e.type === 'income' ? 'income-amount' : 'expense-amount';
        var sign = e.type === 'income' ? '+' : '-';
        html += '<div class="entry-item">' +
            '<div class="entry-info"><strong>' + e.category + '</strong><p>' + e.date + (e.note ? ' • ' + e.note : '') + '</p></div>' +
            '<div class="entry-amount ' + cls + '">' + sign + '₹' + e.amount.toFixed(2) + '</div>' +
            '</div>';
    });
    document.getElementById('entries').innerHTML = html;
}

function renderWeekly() {
    // Last 7 days
    var now = new Date();
    var weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);

    var weekEntries = entries.filter(function(e) {
        return new Date(e.date) >= weekAgo;
    });

    var totalIncome = 0, totalExpense = 0;
    var catIncome = {}, catExpense = {};

    weekEntries.forEach(function(e) {
        if (e.type === 'income') {
            totalIncome += e.amount;
            catIncome[e.category] = (catIncome[e.category] || 0) + e.amount;
        } else {
            totalExpense += e.amount;
            catExpense[e.category] = (catExpense[e.category] || 0) + e.amount;
        }
    });

    document.getElementById('totalIncome').textContent = '₹' + totalIncome.toFixed(2);
    document.getElementById('totalExpense').textContent = '₹' + totalExpense.toFixed(2);
    document.getElementById('balance').textContent = '₹' + (totalIncome - totalExpense).toFixed(2);

    // Category breakdown
    var allCats = new Set([...Object.keys(catIncome), ...Object.keys(catExpense)]);
    var maxAmt = Math.max(...weekEntries.map(e => e.amount), 1);
    var html = '';

    allCats.forEach(function(cat) {
        var inc = catIncome[cat] || 0;
        var exp = catExpense[cat] || 0;
        var total = inc + exp;
        var pct = Math.min((total / (totalIncome + totalExpense || 1)) * 100, 100).toFixed(0);
        html += '<div class="category-row">' +
            '<div class="cat-name">' + cat + '</div>' +
            '<div class="cat-bar-bg"><div class="cat-bar" style="width:' + pct + '%"></div></div>' +
            '<div class="cat-amounts">' +
            '<span style="color:#2E7D32">+₹' + inc.toFixed(2) + '</span>' +
            '<span style="color:#C62828">-₹' + exp.toFixed(2) + '</span>' +
            '</div></div>';
    });

    document.getElementById('categoryBreakdown').innerHTML = html || '<p style="color:#888;padding:10px;">No data this week.</p>';
}

