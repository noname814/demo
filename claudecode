import React, { useState } from 'react';
import './App.css';

const CATEGORIES = ['All', 'Work', 'Personal', 'Shopping', 'Health', 'Other'];
const PRIORITIES = ['Low', 'Medium', 'High'];

function App() {
  const [tasks, setTasks] = useState([
    { id: 1, text: 'Buy groceries', category: 'Shopping', priority: 'Medium', done: false, date: today() },
    { id: 2, text: 'Morning jog', category: 'Health', priority: 'High', done: false, date: today() },
    { id: 3, text: 'Read chapter 5', category: 'Personal', priority: 'Low', done: true, date: today() },
  ]);
  const [text, setText] = useState('');
  const [category, setCategory] = useState('Personal');
  const [priority, setPriority] = useState('Medium');
  const [filter, setFilter] = useState('All');
  const [showDone, setShowDone] = useState(true);
  const [editId, setEditId] = useState(null);
  const [editText, setEditText] = useState('');

  function today() { return new Date().toLocaleDateString(); }

  const addTask = () => {
    if (!text.trim()) return;
    setTasks([...tasks, { id: Date.now(), text: text.trim(), category, priority, done: false, date: today() }]);
    setText('');
  };

  const toggleDone = id => setTasks(tasks.map(t => t.id === id ? { ...t, done: !t.done } : t));
  const deleteTask = id => setTasks(tasks.filter(t => t.id !== id));

  const saveEdit = id => {
    setTasks(tasks.map(t => t.id === id ? { ...t, text: editText } : t));
    setEditId(null);
  };

  const filtered = tasks.filter(t =>
    (filter === 'All' || t.category === filter) &&
    (showDone || !t.done)
  );

  const done = tasks.filter(t => t.done).length;
  const pct = tasks.length ? Math.round((done / tasks.length) * 100) : 0;

  const priorityColor = { Low: '#4CAF50', Medium: '#FF9800', High: '#F44336' };

  return (
    <div className="app">
      <header className="header">
        <h1>📋 Task Manager</h1>
        <div className="progress-wrap">
          <div className="progress-bar" style={{ width: pct + '%' }}></div>
        </div>
        <p className="progress-text">{done} of {tasks.length} tasks done ({pct}%)</p>
      </header>

      {/* Add Task */}
      <div className="add-card">
        <input className="task-input" value={text} onChange={e => setText(e.target.value)}
               placeholder="New task..." onKeyDown={e => e.key === 'Enter' && addTask()}/>
        <div className="selects-row">
          <select value={category} onChange={e => setCategory(e.target.value)}>
            {CATEGORIES.filter(c => c !== 'All').map(c => <option key={c}>{c}</option>)}
          </select>
          <select value={priority} onChange={e => setPriority(e.target.value)}>
            {PRIORITIES.map(p => <option key={p}>{p}</option>)}
          </select>
        </div>
        <button className="btn-add" onClick={addTask}>+ Add Task</button>
      </div>

      {/* Filters */}
      <div className="filters">
        {CATEGORIES.map(c => (
          <button key={c} className={`filter-btn ${filter === c ? 'active' : ''}`}
                  onClick={() => setFilter(c)}>{c}</button>
        ))}
      </div>

      <div className="toggle-done">
        <label>
          <input type="checkbox" checked={showDone} onChange={e => setShowDone(e.target.checked)}/>
          Show completed tasks
        </label>
      </div>

      {/* Task List */}
      <div className="task-list">
        {filtered.length === 0 && <p className="empty">No tasks found. 🎉</p>}
        {filtered.map(task => (
          <div key={task.id} className={`task-item ${task.done ? 'done' : ''}`}>
            <div className="task-left">
              <input type="checkbox" checked={task.done} onChange={() => toggleDone(task.id)}/>
              <div style={{ flex: 1 }}>
                {editId === task.id ? (
                  <input className="edit-input" value={editText}
                         onChange={e => setEditText(e.target.value)}
                         onKeyDown={e => e.key === 'Enter' && saveEdit(task.id)}/>
                ) : (
                  <p className="task-text">{task.text}</p>
                )}
                <div className="task-meta">
                  <span className="tag">{task.category}</span>
                  <span className="priority" style={{ color: priorityColor[task.priority] }}>
                    ● {task.priority}
                  </span>
                  <span className="date">{task.date}</span>
                </div>
              </div>
            </div>
            <div className="task-actions">
              {editId === task.id ? (
                <button className="btn-save" onClick={() => saveEdit(task.id)}>✓</button>
              ) : (
                <button className="btn-edit" onClick={() => { setEditId(task.id); setEditText(task.text); }}>✏️</button>
              )}
              <button className="btn-del" onClick={() => deleteTask(task.id)}>🗑️</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

export default App;

