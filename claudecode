package com.example.libraryapp;

import android.database.Cursor;
import android.os.Bundle;
import android.view.View;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;
import java.util.ArrayList;

public class MainActivity extends AppCompatActivity {

    DatabaseHelper db;
    ListView listView;
    EditText etTitle, etAuthor;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        db = new DatabaseHelper(this);
        listView = findViewById(R.id.listView);
        etTitle = findViewById(R.id.etTitle);
        etAuthor = findViewById(R.id.etAuthor);

        findViewById(R.id.btnAvailable).setOnClickListener(v -> showAvailable());
        findViewById(R.id.btnLent).setOnClickListener(v -> showLent());
        findViewById(R.id.btnReserved).setOnClickListener(v -> showReserved());

        findViewById(R.id.btnAddBook).setOnClickListener(v -> {
            String title = etTitle.getText().toString().trim();
            String author = etAuthor.getText().toString().trim();
            if (title.isEmpty()) { Toast.makeText(this, "Enter title", Toast.LENGTH_SHORT).show(); return; }
            if (db.addBook(title, author)) {
                Toast.makeText(this, "Book added!", Toast.LENGTH_SHORT).show();
                etTitle.setText(""); etAuthor.setText("");
            }
        });

        showAvailable();
    }

    void showAvailable() {
        Cursor c = db.getAvailableBooks();
        ArrayList<String> list = new ArrayList<>();
        while (c.moveToNext()) {
            list.add(c.getString(1) + " by " + c.getString(2));
        }
        c.close();
        setList("Available Books", list);
    }

    void showLent() {
        Cursor c = db.getLentBooks();
        ArrayList<String> list = new ArrayList<>();
        while (c.moveToNext()) {
            list.add(c.getString(0) + " → " + c.getString(1) + " (" + c.getString(2) + ") on " + c.getString(3));
        }
        c.close();
        setList("Lent Books", list);
    }

    void showReserved() {
        Cursor c = db.getReservedBooks();
        ArrayList<String> list = new ArrayList<>();
        while (c.moveToNext()) {
            list.add(c.getString(0) + " reserved by " + c.getString(1) + " on " + c.getString(2));
        }
        c.close();
        setList("Reserved Books", list);
    }

    void setList(String category, ArrayList<String> data) {
        if (data.isEmpty()) data.add("No records found.");
        ArrayAdapter<String> adapter = new ArrayAdapter<>(this, android.R.layout.simple_list_item_1, data);
        listView.setAdapter(adapter);
        Toast.makeText(this, category + ": " + data.size() + " record(s)", Toast.LENGTH_SHORT).show();
    }
