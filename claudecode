import React, { useState } from 'react';
import './App.css';

const conversions = [
  { name: 'Miles to Kilometers',    from: 'miles',  to: 'km',     factor: 1.60934,  icon: '🛣️' },
  { name: 'Kilometers to Miles',    from: 'km',     to: 'miles',  factor: 0.621371, icon: '🛣️' },
  { name: 'Pounds to Kilograms',    from: 'lbs',    to: 'kg',     factor: 0.453592, icon: '⚖️' },
  { name: 'Kilograms to Pounds',    from: 'kg',     to: 'lbs',    factor: 2.20462,  icon: '⚖️' },
  { name: 'Fahrenheit to Celsius',  from: '°F',     to: '°C',     factor: null,     icon: '🌡️' },
  { name: 'Celsius to Fahrenheit',  from: '°C',     to: '°F',     factor: null,     icon: '🌡️' },
  { name: 'Inches to Centimeters',  from: 'in',     to: 'cm',     factor: 2.54,     icon: '📏' },
  { name: 'Centimeters to Inches',  from: 'cm',     to: 'in',     factor: 0.393701, icon: '📏' },
  { name: 'Gallons to Liters',      from: 'gal',    to: 'L',      factor: 3.78541,  icon: '🧪' },
  { name: 'Liters to Gallons',      from: 'L',      to: 'gal',    factor: 0.264172, icon: '🧪' },
];

function convert(value, conv) {
  const n = parseFloat(value);
  if (isNaN(n)) return '';
  if (conv.name === 'Fahrenheit to Celsius') return ((n - 32) * 5 / 9).toFixed(4);
  if (conv.name === 'Celsius to Fahrenheit') return ((n * 9 / 5) + 32).toFixed(4);
  return (n * conv.factor).toFixed(4);
}

function App() {
  const [selected, setSelected] = useState(0);
  const [input, setInput] = useState('');

  const conv = conversions[selected];
  const result = convert(input, conv);

  return (
    <div className="app">
      <header className="app-header">
        <h1>Unit Converter</h1>
        <p>Imperial ↔ Metric</p>
      </header>

      <div className="converter-box">
        <label>Select Conversion</label>
        <select value={selected} onChange={e => { setSelected(Number(e.target.value)); setInput(''); }}>
          {conversions.map((c, i) => (
            <option key={i} value={i}>{c.icon} {c.name}</option>
          ))}
        </select>

        <div className="input-row">
          <div className="input-group">
            <label>Enter {conv.from}</label>
            <input type="number" value={input} onChange={e => setInput(e.target.value)}
                   placeholder={`Value in ${conv.from}`}/>
          </div>
          <div className="arrow">→</div>
          <div className="input-group">
            <label>Result in {conv.to}</label>
            <input type="text" value={result} readOnly placeholder="Result" className="result-input"/>
          </div>
        </div>

        {input && result && (
          <div className="result-display">
            {input} {conv.from} = <strong>{result} {conv.to}</strong>
          </div>
        )}

        <button className="clear-btn" onClick={() => setInput('')}>Clear</button>
      </div>

      <div className="quick-ref">
        <h3>Quick Reference</h3>
        {conversions.map((c, i) => (
          <div key={i} className="ref-row" onClick={() => { setSelected(i); setInput(''); }}>
            <span>{c.icon} {c.name}</span>
            <span className="ref-factor">
              {c.factor ? `× ${c.factor}` : 'formula'}
            </span>
          </div>
        ))}
      </div>
    </div>
  );
}

export default App;

